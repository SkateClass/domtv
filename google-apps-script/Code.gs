/* ЭФИР 2.0 TEST. Отдельный проект и отдельная таблица. Не использовать с HOME 2.2. */
const API='efir2-test-1';
const props=()=>PropertiesService.getScriptProperties();
const cache=()=>CacheService.getScriptCache();
const parse=(s,f)=>{try{const v=JSON.parse(s);return v==null?f:v}catch(e){return f}};
const random=()=>Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');
const digest=s=>Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s)));
function withLock(fn){const l=LockService.getScriptLock();if(!l.tryLock(4000))throw Error('BUSY: повторите запрос через несколько секунд');try{return fn()}finally{l.releaseLock()}}
function setup(){const p=props();if(p.getProperty('EFIR2_DB'))throw Error('Этот проект уже настроен. Повторное создание отключено.');const db=SpreadsheetApp.create('ЭФИР 2.0 TEST — домашнее ТВ'),pin=String(Math.floor(100000+Math.random()*900000));db.getSheets()[0].setName('Инструкция').getRange('A1:B5').setValues([['ЭФИР 2.0 TEST','Не связано со старой системой'],['PIN','Изменяется на листе Settings, B2'],['Сценарии','Исполняются только при открытом активном плеере'],['Каталог','Снимки CAT_*: не редактировать вручную'],['Безопасность','Не публикуйте таблицу и ключи сессий']]);const settings=db.insertSheet('Settings');settings.getRange('A1:B2').setNumberFormat('@').setValues([['key','value'],['PIN',pin]]);db.insertSheet('Devices').appendRow(['created_at','role','token_fingerprint','expires_at']);db.insertSheet('Commands').appendRow(['created_at','id','command_json']);db.insertSheet('Events').appendRow(['at','event','detail']);p.setProperties({EFIR2_DB:db.getId(),SALT:random(),QUEUE:'[]',RECEIPTS:'[]'});console.log('НОВАЯ ТАБЛИЦА: '+db.getUrl());console.log('PIN ПЕРВОГО ВХОДА: '+pin);console.log('Теперь разверните как веб-приложение: выполнять от своего имени, доступ — все.');}
function db(){const id=props().getProperty('EFIR2_DB');if(!id)throw Error('Сначала выполните setup()');return SpreadsheetApp.openById(id)}
function pinFingerprint(){let f=cache().get('pin2');if(f)return f;const pin=String(db().getSheetByName('Settings').getRange('B2').getDisplayValue()).trim();if(!/^\d{6,12}$/.test(pin))throw Error('PIN_CONFIG: Settings!B2 должен содержать 6–12 цифр');f=digest(props().getProperty('SALT')+'|'+pin);cache().put('pin2',f,30);return f}
function auth(q,role){const token=String(q.session||'');if(!/^[a-f0-9]{64}$/.test(token))throw Error('AUTH: войдите по PIN');const h=digest(token),s=parse(props().getProperty('SESSION_'+h),null);if(!s||s.expires<Date.now()||s.pin!==pinFingerprint())throw Error('AUTH: сессия истекла или PIN изменён');if(role&&s.role!==role)throw Error('AUTH: неверная роль');return s}
function lease(){return parse(props().getProperty('LEASE'),{})}
function assertPrimary(q){const l=lease();if(l.instance!==q.instance||l.session!==digest(q.session)||Date.now()-l.at>30000)throw Error('PLAYER_BUSY: этот плеер не активный приёмник')}
function login(q){if(!/^[\w-]{16,100}$/.test(String(q.nonce||'')))throw Error('Неверный nonce');return withLock(()=>{const p=props(),now=Date.now();let rate=parse(p.getProperty('LOGIN_RATE'),{at:now,count:0});if(now-rate.at>300000)rate={at:now,count:0};let result;if(rate.count>=10)result={ok:false,error:'RATE: подождите пять минут'};else if(!/^\d{6,12}$/.test(String(q.pin||''))||digest(p.getProperty('SALT')+'|'+q.pin)!==pinFingerprint()){rate.count++;p.setProperty('LOGIN_RATE',JSON.stringify(rate));result={ok:false,error:'Неверный PIN'}}else{if(!['player','remote'].includes(q.role))throw Error('Неверная роль');const all=p.getProperties(),sessions=Object.keys(all).filter(k=>k.indexOf('SESSION_')===0);for(const k of sessions)if(parse(all[k],{}).expires<now)p.deleteProperty(k);if(sessions.length>150)throw Error('Лимит сессий: удалите старые через revokeAllSessions');const token=random(),h=digest(token),expires=now+30*86400000;p.setProperty('SESSION_'+h,JSON.stringify({role:q.role,pin:pinFingerprint(),expires}));db().getSheetByName('Devices').appendRow([new Date().toISOString(),q.role,h,new Date(expires).toISOString()]);result={ok:true,session:token}}cache().put('login2.'+q.nonce,JSON.stringify(result),180);return {ok:true}})}
function out(d,callback){if(callback){if(!/^efir2_[a-zA-Z0-9_]{1,100}$/.test(callback))return ContentService.createTextOutput('{"ok":false,"error":"Invalid callback"}').setMimeType(ContentService.MimeType.JSON);return ContentService.createTextOutput(callback+'('+JSON.stringify(d).replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029')+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}return ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON)}
function doGet(e){const q=e.parameter||{};let result;try{if(q.action==='health')result={ok:true,api:API};else if(q.action==='loginResult'){if(!/^[\w-]{16,100}$/.test(String(q.nonce||'')))throw Error('Неверный nonce');result=parse(cache().get('login2.'+q.nonce),{ok:true,pending:true})}else{auth(q,q.action==='poll'?'player':null);if(q.action==='operation'){result=parse(cache().get('op2.'+digest(q.session)+'|'+String(q.requestId)),{ok:true,pending:true})}else if(q.action==='status'||q.action==='poll'){const p=props(),l=lease(),primary=l.instance===q.instance&&l.session===digest(q.session)&&Date.now()-l.at<30000;result={ok:true,api:API,serverTime:Date.now(),primary,state:parse(p.getProperty('STATE'),null),catalogVersion:p.getProperty('CAT_VERSION')||'',result:q.commandId?parse(p.getProperty('ACK_'+String(q.commandId)),null):null};if(q.action==='poll'&&primary){const queue=parse(p.getProperty('QUEUE'),[]);const sheet=db().getSheetByName('Commands');result.commands=queue.slice(0,4).map(item=>parse(sheet.getRange(item.row,3).getValue(),null)).filter(Boolean)}}else if(q.action==='catalog'){const p=props(),sheetId=p.getProperty('CAT_SHEET');if(!sheetId)result={ok:true,version:'',model:null};else{const sheet=db().getSheets().find(s=>String(s.getSheetId())===sheetId);if(!sheet)throw Error('RETRY: каталог обновляется');const encoded=sheet.getRange(2,1,sheet.getLastRow()-1,1).getValues().map(r=>r[0]).join(''),text=Utilities.newBlob(Utilities.base64DecodeWebSafe(encoded)).getDataAsString('UTF-8');result={ok:true,version:sheet.getRange('A1').getValue(),model:JSON.parse(text)}}}else throw Error('Неизвестное действие')}}catch(error){result={ok:false,error:error.message}}return out(result,String(q.callback||''))}
function heartbeat(q){auth(q,'player');return withLock(()=>{if(!/^[\w-]{16,100}$/.test(String(q.instance||'')))throw Error('Неверный instance');const p=props(),old=lease(),now=Date.now(),h=digest(q.session);if(old.at&&now-old.at<30000&&(old.instance!==q.instance||old.session!==h))return {ok:false,error:'PLAYER_BUSY: другой плеер уже активен'};p.setProperty('LEASE',JSON.stringify({instance:q.instance,session:h,at:now}));const s=q.state||{};const state={channelId:String(s.channelId||'').slice(0,200),channelName:String(s.channelName||'').slice(0,180),sourceId:String(s.sourceId||'').slice(0,100),sourceLabel:String(s.sourceLabel||'').slice(0,200),phase:String(s.phase||'').slice(0,40),detail:String(s.detail||'').slice(0,400),bufferSeconds:Number(s.bufferSeconds)||0,quality:String(s.quality||'low').slice(0,30),playerId:q.instance,at:now};p.setProperty('STATE',JSON.stringify(state));return {ok:true}})}
function command(q){auth(q,'remote');return withLock(()=>{const p=props(),cmd=q.command||{};if(!/^cmd_[\w-]{16,100}$/.test(String(cmd.id||'')))throw Error('Неверный ID команды');if(!['select','retry','stop','simulate','sourceArchive','channelArchive','scenarios','scenarioToggle','settings','import','merge','update'].includes(cmd.type))throw Error('Неизвестная команда');const text=JSON.stringify({...cmd,createdAt:Date.now()});if(Utilities.newBlob(text).getBytes().length>45000)throw Error('COMMAND_SIZE: в облаке передавайте большие каталоги через импорт на ПК, не через пульт');const queue=parse(p.getProperty('QUEUE'),[]);if(queue.some(x=>x.id===cmd.id)||p.getProperty('ACK_'+cmd.id))return {ok:true};if(queue.length>=20)throw Error('QUEUE_FULL: очередь заполнена');const sheet=db().getSheetByName('Commands');sheet.appendRow([new Date().toISOString(),cmd.id,text]);queue.push({id:cmd.id,row:sheet.getLastRow()});p.setProperty('QUEUE',JSON.stringify(queue));return {ok:true}})}
function acknowledge(q){auth(q,'player');return withLock(()=>{assertPrimary(q);const p=props(),queue=parse(p.getProperty('QUEUE'),[]),id=String(q.commandId||'');if(!queue.some(c=>c.id===id))return {ok:true};const r=q.result||{},result={status:r.status==='error'?'error':'applied',message:String(r.message||'').slice(0,500),at:Date.now()};p.setProperty('ACK_'+id,JSON.stringify(result));p.setProperty('QUEUE',JSON.stringify(queue.filter(c=>c.id!==id)));const ids=parse(p.getProperty('RECEIPTS'),[]);ids.push(id);while(ids.length>80)p.deleteProperty('ACK_'+ids.shift());p.setProperty('RECEIPTS',JSON.stringify(ids));return {ok:true}})}
function publish(q){auth(q,'player');assertPrimary(q);const m=q.model;if(!m||m.schema!==2||!Array.isArray(m.channels)||m.channels.length>3000||!Array.isArray(m.scenarios))throw Error('Неверный каталог');const clean={schema:2,version:String(m.version||'2'),channels:m.channels,scenarios:m.scenarios,settings:m.settings||{}};const text=JSON.stringify(clean);if(Utilities.newBlob(text).getBytes().length>2500000)throw Error('Каталог больше 2,5 МБ');const version=String(q.version||'').slice(0,100);if(!/^[a-zA-Z0-9_-]{1,100}$/.test(version))throw Error('Неверная версия каталога');if(props().getProperty('CAT_VERSION')===version)return {ok:true};const book=db(),sheet=book.insertSheet('CAT_'+Date.now()+'_'+Utilities.getUuid().slice(0,6));try{const encoded=Utilities.base64EncodeWebSafe(Utilities.newBlob(text).getBytes()).replace(/=+$/,''),rows=[[version]];for(let i=0;i<encoded.length;i+=14000)rows.push([encoded.slice(i,i+14000)]);if(sheet.getMaxRows()<rows.length)sheet.insertRowsAfter(sheet.getMaxRows(),rows.length-sheet.getMaxRows());sheet.getRange(1,1,rows.length,1).setValues(rows);SpreadsheetApp.flush();withLock(()=>{assertPrimary(q);props().setProperties({CAT_SHEET:String(sheet.getSheetId()),CAT_VERSION:version})});return {ok:true}}catch(e){book.deleteSheet(sheet);throw e}}
function doPost(e){let d,q={};try{const raw=e.postData&&e.postData.contents||'';if(raw.length>2800000)throw Error('Слишком большой запрос');q=JSON.parse(raw);if(q.action==='login')d=login(q);else if(q.action==='heartbeat')d=heartbeat(q);else if(q.action==='command')d=command(q);else if(q.action==='ack')d=acknowledge(q);else if(q.action==='publish')d=publish(q);else if(q.action==='logout'){auth(q);props().deleteProperty('SESSION_'+digest(q.session));d={ok:true}}else throw Error('Неизвестное действие')}catch(e){d={ok:false,error:e.message}}if(q.requestId&&q.session)cache().put('op2.'+digest(q.session)+'|'+String(q.requestId),JSON.stringify(d),120);return out(d)}
function revokeAllSessions(){const p=props();for(const k of Object.keys(p.getProperties()))if(k.indexOf('SESSION_')===0)p.deleteProperty(k);p.deleteProperty('LEASE');cache().remove('pin2');console.log('Все сессии ЭФИР 2.0 отозваны. Войдите по PIN заново.');}
function cleanupSnapshots(){const current=props().getProperty('CAT_SHEET'),book=db(),old=book.getSheets().filter(s=>s.getName().indexOf('CAT_')===0&&String(s.getSheetId())!==current).sort((a,b)=>b.getName().localeCompare(a.getName()));for(const s of old.slice(2))book.deleteSheet(s);console.log('Сохранён текущий и два предыдущих снимка каталога.');}
